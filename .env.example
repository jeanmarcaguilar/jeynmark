# Contact Form Email Configuration (Required for contact form to work)
# Using Gmail SMTP with Nodemailer backend
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate an App Password: https://myaccount.google.com/apppasswords (App name: Portfolio Contact)
# 3. Paste the generated 16-character code into EMAIL_PASS below (without spaces)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx
EMAIL_TO=your_destination_email@gmail.com

# GitHub contributions heatmap
# Optional locally: without a token, Vite uses a public contributions API.
# On Vercel, set GITHUB_TOKEN (classic PAT with read:user is enough).
GITHUB_TOKEN=
VITE_GITHUB_USERNAME=jeanmarcaguilar

# Spotify now-playing widget (Hero music player)
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Add Redirect URI: http://127.0.0.1:8888/callback
# 3. Copy Client ID and Client Secret here
# 4. Run: npm run spotify:auth
# 5. Paste the printed SPOTIFY_REFRESH_TOKEN below
# Also set these three values in Vercel Project Settings → Environment Variables
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Live viewers (optional, recommended on Vercel)
# Locally, presence is stored in memory/file so two browser tabs show 2.
# On Vercel, add a free Upstash Redis REST pair so all visitors share one live count:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Visitor Analytics Email Notifications (Backend only - sensitive credentials)
# Option A: Gmail SMTP (Requires a 16-character Google App Password)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate an App Password: https://myaccount.google.com/apppasswords (App name: Portfolio Analytics)
# 3. Paste the generated 16-character code into EMAIL_PASS below (without spaces)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx
EMAIL_TO=your_destination_email@gmail.com
ANALYTICS_RATE_LIMIT_MINS=10

# Option B: Resend API (Alternative to SMTP)
# RESEND_API_KEY=re_123456789
